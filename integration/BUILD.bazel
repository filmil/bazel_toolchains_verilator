load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

# Verilator, asked what it is. A binary that runs and knows its own
# version is a binary that was packaged with the include tree it needs
# and marked executable, which are the two ways this can go wrong.
genrule(
    name = "version",
    outs = ["version.txt"],
    cmd = "$(location @verilator_prebuilt//:verilator) --version | cut -d' ' -f1 | tr -d '\n' > $@",
    tools = ["@verilator_prebuilt//:verilator"],
)

write_file(
    name = "expected",
    out = "expected.txt",
    content = ["Verilator"],
)

diff_test(
    name = "verilator_runs_test",
    file1 = ":version",
    file2 = ":expected",
)
